      "settings": {
        "custom_code": "<div class=\"hej-path-scroll\">\n  <div class=\"hej-path-sticky\">\n    <div class=\"hej-mobile-delivery-label\">Klavon pet store</div>\n\n    <div class=\"hej-path-track\">\n      <section class=\"hej-path-panel hej-path-intro\">\n        <div class=\"hej-copy\">\n          <p class=\"hej-eyebrow\"></p>\n          <h2>Welcom<br>to klavon</h2>\n          <p>Discover carefully selected products for dogs and cats designed to make everyday life easier. Quality, comfort, and convenience in every order.</p>\n        </div>\n      </section>\n\n      <section class=\"hej-path-panel\">\n        <div class=\"hej-photo hej-photo-1\"><span> PRODUCT </span></div>\n        <div class=\"hej-copy\">\n          <p class=\"hej-step-num\">01</p>\n          <h3>CHOOSE YOUR PRODUCT</h3>\n          <ul>\n            <li>Browse our collection.</li>\n            <li>Find the right product for your pet</li>\n          </ul>\n          <a href=\"/collections/all\">Shop Now</a>\n        </div>\n      </section>\n\n      <section class=\"hej-path-panel\">\n        <div class=\"hej-photo hej-photo-2\"><span> PAYMENT </span></div>\n        <div class=\"hej-copy\">\n          <p class=\"hej-step-num\">02</p>\n          <h3>PLACE YOUR ORDER</h3>\n          <ul>\n            <li>Safe and secure checkout.</li>\n            <li>Easy payment process.</li>\n          </ul>\n          <a href=\"/pages/contact\">shop now</a>\n        </div>\n      </section>\n\n      <section class=\"hej-path-panel\">\n        <div class=\"hej-photo hej-photo-3\"><span> PREPARED </span></div>\n        <div class=\"hej-copy\">\n          <p class=\"hej-step-num\">03</p>\n          <h3>WE PREPARE YOUR ORDER</h3>\n          <ul>\n            <li>Carefully processed.</li>\n            <li>Prepared for shipment.</li>\n          </ul>\n          <a href=\"/collections/all\">shop now</a>\n        </div>\n      </section>\n\n      <section class=\"hej-path-panel hej-path-final\">\n        <div class=\"hej-photo hej-photo-4\"><span>SHIPPING</span></div>\n        <div class=\"hej-copy\">\n          <p class=\"hej-step-num\">04</p>\n          <h3>FREE SHIPPING</h3>\n          <ul>\n            <li>Delivered to your door.</li>\n            <li>Free shipping for Klavon customers.</li>\n          </ul>\n          <a href=\"/collections/all\">Order now</a>\n        </div>\n      </section>\n    </div>\n\n    <div class=\"hej-path-route\" aria-hidden=\"true\">\n      <svg viewBox=\"0 0 1400 120\" preserveAspectRatio=\"none\">\n        <path class=\"hej-route-base\" pathLength=\"1\" d=\"M0 70 C180 70 220 90 360 76 S610 62 750 74 S980 92 1120 72 S1300 66 1400 86\"></path>\n        <path class=\"hej-route-progress\" pathLength=\"1\" d=\"M0 70 C180 70 220 90 360 76 S610 62 750 74 S980 92 1120 72 S1300 66 1400 86\"></path>\n      </svg>\n\n      <div class=\"hej-mobile-route-line\"></div>\n\n      <div class=\"hej-route-dot\">\n        <svg viewBox=\"0 0 24 24\"><path d=\"M8 5l10 7-10 7V5Z\"></path></svg>\n      </div>\n\n      <div class=\"hej-route-stop hej-route-stop-1\">1</div>\n      <div class=\"hej-route-stop hej-route-stop-2\">2</div>\n      <div class=\"hej-route-stop hej-route-stop-3\">3</div>\n      <div class=\"hej-route-stop hej-route-stop-4\">4</div>\n    </div>\n  </div>\n</div>\n\n<style>\n  .hej-path-scroll {\n    --bg: #ffffff;\n    --black: #050505;\n    --lime: #dcff2f;\n    --lime-dark: #a8d600;\n    --muted: #555b63;\n    --line: rgba(5, 5, 5, .24);\n    --progress: 0;\n    --track-x: 0px;\n    height: 430vh;\n    margin: 0 calc(50% - 50vw);\n    background: var(--bg);\n    color: var(--black);\n    position: relative;\n    overflow: visible;\n  }\n\n  .hej-path-sticky {\n    position: sticky;\n    top: 0;\n    height: 100vh;\n    overflow: hidden;\n    display: flex;\n    align-items: center;\n  }\n\n  .hej-mobile-delivery-label {\n    display: none;\n  }\n\n  .hej-path-track {\n    display: flex;\n    align-items: center;\n    width: max-content;\n    gap: clamp(70px, 8vw, 150px);\n    padding: 0 clamp(32px, 8vw, 160px);\n    transform: translate3d(var(--track-x), 0, 0);\n    will-change: transform;\n  }\n\n  .hej-path-panel {\n    width: min(92vw, 1080px);\n    min-height: 62vh;\n    flex: 0 0 auto;\n    display: grid;\n    grid-template-columns: minmax(320px, .95fr) minmax(360px, 1fr);\n    gap: clamp(42px, 5vw, 90px);\n    align-items: center;\n  }\n\n  .hej-path-intro {\n    width: min(92vw, 920px);\n    display: flex;\n    justify-content: center;\n    text-align: center;\n  }\n\n  .hej-path-final {\n    width: min(92vw, 1080px);\n  }\n\n  .hej-copy {\n    max-width: 640px;\n  }\n\n  .hej-eyebrow,\n  .hej-step-num {\n    margin: 0 0 18px;\n    font-size: 14px;\n    font-weight: 900;\n    text-transform: uppercase;\n    color: var(--lime-dark);\n  }\n\n  .hej-path-scroll h2,\n  .hej-path-scroll h3,\n  .hej-path-scroll p {\n    margin: 0;\n    letter-spacing: 0;\n  }\n\n  .hej-path-scroll h2,\n  .hej-path-scroll h3 {\n    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;\n    text-transform: uppercase;\n    color: var(--black);\n    font-weight: 900;\n  }\n\n  .hej-path-scroll h2 {\n    font-size: clamp(76px, 9vw, 160px);\n    line-height: .86;\n  }\n\n  .hej-path-scroll h3 {\n    font-size: clamp(56px, 5.8vw, 104px);\n    line-height: .88;\n  }\n\n  .hej-path-scroll p {\n    margin-top: 28px;\n    color: var(--muted);\n    font-size: clamp(18px, 1.35vw, 25px);\n    line-height: 1.55;\n  }\n\n  .hej-path-scroll ul {\n    list-style: none;\n    padding: 0;\n    margin: 34px 0 0;\n    display: grid;\n    gap: 18px;\n  }\n\n  .hej-path-scroll li {\n    position: relative;\n    padding-left: 42px;\n    color: var(--black);\n    font-size: clamp(17px, 1.2vw, 22px);\n    line-height: 1.45;\n    font-weight: 700;\n  }\n\n  .hej-path-scroll li::before {\n    content: \"\";\n    position: absolute;\n    left: 0;\n    top: .25em;\n    width: 22px;\n    height: 14px;\n    border-left: 5px solid var(--lime-dark);\n    border-bottom: 5px solid var(--lime-dark);\n    transform: rotate(-45deg);\n  }\n\n  .hej-path-scroll a {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    min-width: 230px;\n    margin-top: 42px;\n    padding: 22px 34px;\n    background: var(--lime);\n    color: var(--black);\n    text-decoration: none;\n    text-transform: uppercase;\n    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;\n    font-size: 28px;\n    line-height: 1;\n    border: 3px solid var(--black);\n    box-shadow: 7px 7px 0 var(--black);\n    transition: transform .2s ease, box-shadow .2s ease;\n    position: relative;\n    overflow: hidden;\n    isolation: isolate;\n    animation: hejButtonPulse 2.25s ease-in-out infinite;\n  }\n\n  .hej-path-scroll a::after {\n    content: \"\";\n    position: absolute;\n    top: -30%;\n    bottom: -30%;\n    left: -60%;\n    width: 42%;\n    background: linear-gradient(90deg, transparent, rgba(255,255,255,.72), transparent);\n    transform: skewX(-18deg);\n    animation: hejButtonShine 3.2s ease-in-out infinite;\n    z-index: -1;\n  }\n\n  .hej-path-scroll a:hover {\n    transform: translate(4px, 4px);\n    box-shadow: 3px 3px 0 var(--black);\n    animation-play-state: paused;\n  }\n\n  .hej-photo {\n    height: clamp(360px, 42vw, 560px);\n    background: #f5f5f5;\n    border: 3px solid var(--black);\n    position: relative;\n    display: grid;\n    place-items: center;\n    overflow: hidden;\n    transform: rotate(-4deg);\n    box-shadow: 14px 14px 0 var(--lime);\n    animation: hejPhotoFloat 4.6s ease-in-out infinite;\n  }\n\n  .hej-photo::before {\n    content: \"\";\n    position: absolute;\n    inset: 12%;\n    background:\n      linear-gradient(135deg, rgba(255,255,255,.6), transparent 40%),\n      repeating-linear-gradient(45deg, rgba(5,5,5,.08) 0 18px, transparent 18px 36px);\n  }\n\n  .hej-photo span {\n    position: relative;\n    z-index: 1;\n    padding: 18px 26px;\n    background: var(--black);\n    color: #fff;\n    font-family: Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif;\n    font-size: clamp(44px, 5vw, 82px);\n    line-height: .9;\n    text-transform: uppercase;\n    transform: rotate(-7deg);\n    animation: hejPhotoLabelPulse 2.8s ease-in-out infinite;\n  }\n\n  .hej-photo-1 { animation-delay: 0s; }\n  .hej-photo-2 { transform: rotate(3deg); animation-delay: .35s; }\n  .hej-photo-2 span { background: #b47a3d; }\n\n  .hej-photo-3 { transform: rotate(-2deg); animation-delay: .7s; }\n  .hej-photo-3 span {\n    background: var(--lime);\n    color: var(--black);\n    border: 3px solid var(--black);\n  }\n\n  .hej-photo-4 { transform: rotate(2deg); animation-delay: 1.05s; }\n  .hej-photo-4 span {\n    background: var(--black);\n    color: var(--lime);\n  }\n\n  .hej-path-route {\n    position: absolute;\n    left: 0;\n    right: 0;\n    bottom: 5vh;\n    height: 120px;\n    pointer-events: none;\n  }\n\n  .hej-path-route svg {\n    position: absolute;\n    inset: 0;\n    width: 100%;\n    height: 100%;\n    overflow: visible;\n  }\n\n  .hej-route-base,\n  .hej-route-progress {\n    fill: none;\n    stroke-width: 5;\n    stroke-linecap: round;\n  }\n\n  .hej-route-base {\n    stroke: var(--line);\n    stroke-dasharray: .018 .018;\n  }\n\n  .hej-route-progress {\n    stroke: var(--lime-dark);\n    stroke-dasharray: var(--progress) 1;\n  }\n\n  .hej-route-dot {\n    position: absolute;\n    left: calc(var(--progress) * 88vw + 6vw);\n    top: 40px;\n    width: 58px;\n    height: 58px;\n    border-radius: 50%;\n    background: var(--lime);\n    border: 3px solid var(--black);\n    display: grid;\n    place-items: center;\n    transform: translate(-50%, -50%);\n    z-index: 4;\n    box-shadow: 0 12px 30px rgba(0,0,0,.14);\n    animation: hejRouteDotPulse 1.75s ease-in-out infinite;\n  }\n\n  .hej-route-dot svg {\n    position: static;\n    width: 26px;\n    height: 26px;\n    fill: var(--black);\n    animation: hejArrowNudge 1.1s ease-in-out infinite;\n  }\n\n  .hej-route-stop {\n    position: absolute;\n    top: 54px;\n    width: 42px;\n    height: 42px;\n    border-radius: 50%;\n    background: var(--black);\n    color: #fff;\n    display: grid;\n    place-items: center;\n    font-weight: 900;\n    transform: translate(-50%, -50%);\n    z-index: 3;\n  }\n\n  .hej-route-stop.active {\n    background: var(--lime);\n    color: var(--black);\n    border: 3px solid var(--black);\n    animation: hejStopPop .42s ease-out both;\n  }\n\n  .hej-route-stop-1 { left: 28%; }\n  .hej-route-stop-2 { left: 49%; }\n  .hej-route-stop-3 { left: 70%; }\n  .hej-route-stop-4 { left: 88%; }\n\n  .hej-mobile-route-line {\n    display: none;\n  }\n\n  @keyframes hejPhotoFloat {\n    0%, 100% { translate: 0 0; scale: 1; }\n    50% { translate: 0 -10px; scale: 1.025; }\n  }\n\n  @keyframes hejPhotoLabelPulse {\n    0%, 100% { scale: 1; }\n    50% { scale: 1.045; }\n  }\n\n  @keyframes hejButtonPulse {\n    0%, 100% {\n      translate: 0 0;\n      scale: 1;\n      box-shadow: 7px 7px 0 var(--black);\n    }\n\n    50% {\n      translate: 0 -4px;\n      scale: 1.035;\n      box-shadow: 10px 12px 0 var(--black);\n    }\n  }\n\n  @keyframes hejButtonShine {\n    0%, 45% { left: -60%; }\n    72%, 100% { left: 125%; }\n  }\n\n  @keyframes hejRouteDotPulse {\n    0%, 100% {\n      scale: 1;\n      box-shadow: 0 12px 30px rgba(0,0,0,.14);\n    }\n\n    50% {\n      scale: 1.12;\n      box-shadow: 0 16px 38px rgba(0,0,0,.2);\n    }\n  }\n\n  @keyframes hejArrowNudge {\n    0%, 100% { translate: 0 0; }\n    50% { translate: 3px 0; }\n  }\n\n  @keyframes hejStopPop {\n    0% { scale: .82; }\n    70% { scale: 1.14; }\n    100% { scale: 1; }\n  }\n\n  @keyframes hejDeliveryLabel {\n    0%, 100% { translate: 0 0; scale: 1; }\n    50% { translate: 0 -3px; scale: 1.025; }\n  }\n\n  @media (max-width: 749px) {\n    .hej-path-scroll {\n      height: auto;\n      min-height: 100vh;\n      background: #ffffff;\n      overflow: hidden;\n    }\n\n    .hej-path-sticky {\n      position: relative;\n      top: auto;\n      height: auto;\n      min-height: 0;\n      overflow: visible;\n      display: block;\n      padding: 42px 0 80px;\n    }\n\n    .hej-mobile-delivery-label {\n      display: inline-flex;\n      align-items: center;\n      justify-content: center;\n      margin: 0 22px 28px;\n      padding: 13px 18px;\n      background: var(--lime);\n      color: var(--black);\n      border: 3px solid var(--black);\n      box-shadow: 5px 5px 0 var(--black);\n      font-weight: 900;\n      text-transform: uppercase;\n      font-size: 14px;\n      line-height: 1.1;\n      position: relative;\n      z-index: 5;\n      animation: hejDeliveryLabel 2.4s ease-in-out infinite;\n    }\n\n    .hej-path-track {\n      display: grid;\n      width: 100%;\n      gap: 72px;\n      padding: 0 22px;\n      transform: none !important;\n      position: relative;\n      z-index: 2;\n    }\n\n    .hej-path-panel,\n    .hej-path-intro,\n    .hej-path-final {\n      width: 100%;\n      min-height: auto;\n      display: grid;\n      grid-template-columns: 1fr;\n      gap: 24px;\n      text-align: left;\n      padding: 0 72px 0 0;\n    }\n\n    .hej-path-intro {\n      text-align: left;\n      min-height: 64vh;\n      align-content: start;\n      padding-top: 16px;\n    }\n\n    .hej-path-scroll h2 {\n      font-size: clamp(56px, 17vw, 78px);\n      line-height: .88;\n    }\n\n    .hej-path-scroll h3 {\n      font-size: clamp(40px, 12vw, 58px);\n      line-height: .92;\n    }\n\n    .hej-path-scroll p {\n      margin-top: 18px;\n      font-size: 16px;\n      line-height: 1.5;\n    }\n\n    .hej-eyebrow,\n    .hej-step-num {\n      margin-bottom: 12px;\n      font-size: 14px;\n    }\n\n    .hej-path-scroll ul {\n      margin-top: 22px;\n      gap: 14px;\n    }\n\n    .hej-path-scroll li {\n      font-size: 16px;\n      padding-left: 34px;\n    }\n\n    .hej-path-scroll li::before {\n      width: 18px;\n      height: 11px;\n      border-left-width: 4px;\n      border-bottom-width: 4px;\n    }\n\n    .hej-path-scroll a {\n      min-width: 0;\n      width: 100%;\n      margin-top: 26px;\n      padding: 18px 20px;\n      font-size: 22px;\n      animation-duration: 1.9s;\n    }\n\n    .hej-photo {\n      order: -1;\n      width: min(100%, 420px);\n      height: 240px;\n      transform: rotate(-3deg);\n      box-shadow: 9px 9px 0 var(--lime);\n      animation-duration: 3.8s;\n    }\n\n    .hej-photo span {\n      font-size: 36px;\n      padding: 14px 20px;\n    }\n\n    .hej-path-route {\n      position: absolute;\n      inset: 0;\n      height: auto;\n      pointer-events: none;\n      z-index: 20;\n    }\n\n    .hej-path-route > svg {\n      display: none;\n    }\n\n    .hej-mobile-route-line {\n      display: block;\n      position: absolute;\n      top: 190px;\n      right: 30px;\n      bottom: 120px;\n      width: 4px;\n      background:\n        linear-gradient(var(--lime-dark), var(--lime-dark)) top / 100% calc(var(--progress) * 100%) no-repeat,\n        repeating-linear-gradient(to bottom, rgba(5,5,5,.26) 0 16px, transparent 16px 30px);\n      border-radius: 999px;\n      z-index: 1;\n    }\n\n    .hej-mobile-route-line::before,\n    .hej-mobile-route-line::after {\n      content: \"\";\n      position: absolute;\n      right: 0;\n      width: 72px;\n      height: 4px;\n      background: var(--lime-dark);\n      border-radius: 999px;\n      transform-origin: right center;\n    }\n\n    .hej-mobile-route-line::before {\n      top: 18%;\n      transform: rotate(-32deg);\n    }\n\n    .hej-mobile-route-line::after {\n      top: 55%;\n      transform: rotate(28deg);\n      opacity: .45;\n    }\n\n    .hej-route-dot {\n      position: fixed;\n      top: 76vh;\n      left: auto;\n      right: 14px;\n      width: 44px;\n      height: 44px;\n      transform: none;\n      margin: 0;\n      animation-duration: 1.45s;\n      z-index: 999;\n    }\n\n    .hej-route-dot svg {\n      width: 19px;\n      height: 19px;\n    }\n\n    .hej-route-stop {\n      right: 12px;\n      left: auto;\n      width: 36px;\n      height: 36px;\n      font-size: 14px;\n      transform: translateY(-50%);\n      z-index: 30;\n    }\n\n    .hej-route-stop-1 { top: 29%; }\n    .hej-route-stop-2 { top: 47%; }\n    .hej-route-stop-3 { top: 65%; }\n    .hej-route-stop-4 { top: 84%; }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    .hej-photo,\n    .hej-photo span,\n    .hej-path-scroll a,\n    .hej-path-scroll a::after,\n    .hej-route-dot,\n    .hej-route-dot svg,\n    .hej-route-stop.active,\n    .hej-mobile-delivery-label {\n      animation: none !important;\n    }\n  }\n</style>\n\n<script>\n  (() => {\n    function initHejPathScroll() {\n      const sections = document.querySelectorAll('.hej-path-scroll');\n      if (!sections.length) return;\n\n      const clamp = (value, min, max) => Math.min(Math.max(value, min), max);\n      let ticking = false;\n\n      function updateSection(section) {\n        const track = section.querySelector('.hej-path-track');\n        const stops = [...section.querySelectorAll('.hej-route-stop')];\n        if (!track) return;\n\n        const rect = section.getBoundingClientRect();\n        const scrollable = Math.max(1, section.offsetHeight - window.innerHeight);\n        const progress = clamp(-rect.top / scrollable, 0, 1);\n        const isMobile = window.matchMedia('(max-width: 749px)').matches;\n\n        section.style.setProperty('--progress', progress.toFixed(4));\n\n        if (!isMobile) {\n          const maxMove = Math.max(0, track.scrollWidth - window.innerWidth);\n          section.style.setProperty('--track-x', `${-progress * maxMove}px`);\n        } else {\n          section.style.setProperty('--track-x', '0px');\n        }\n\n        stops.forEach((stop, index) => {\n          stop.classList.toggle('active', progress >= [0.18, 0.4, 0.62, 0.82][index]);\n        });\n      }\n\n      function update() {\n        sections.forEach(updateSection);\n        ticking = false;\n      }\n\n      function requestUpdate() {\n        if (ticking) return;\n        ticking = true;\n        requestAnimationFrame(update);\n      }\n\n      window.addEventListener('scroll', requestUpdate, { passive: true });\n      window.addEventListener('resize', requestUpdate);\n      window.addEventListener('load', requestUpdate);\n\n      requestUpdate();\n      setTimeout(requestUpdate, 300);\n    }\n\n    if (document.readyState === 'loading') {\n      document.addEventListener('DOMContentLoaded', initHejPathScroll);\n    } else {\n      initHejPathScroll();\n    }\n  })();\n</script>",
