        "custom_code": "<div class=\"hej-path-scroll\">\n  <div class=\"hej-path-sticky\">\n    <div class=\"hej-mobile-delivery-label\">Klavon pet store</div>\n\n    <div class=\"hej-path-track\">\n      <section class=\"hej-path-panel hej-path-intro\">\n        <div class=\"hej-copy\">\n          <p class=\"hej-eyebrow\"></p>\n          <h2>Welcom<br>to klavon</h2>\n          <p>Discover carefully selected products for dogs and cats designed to make everyday life easier. Quality, comfort, and convenience in every order.</p>\n        </div>\n      </section>\n\n      <section class=\"hej-path-panel\">\n        <div class=\"hej-photo hej-photo-1\"><span> PRODUCT </span></div>\n        <div class=\"hej-copy\">\n          <p class=\"hej-step-num\">01</p>\n          <h3>CHOOSE YOUR PRODUCT</h3>\n          <ul>\n            <li>Browse our collection.</li>\n            <li>Find the right product for your pet</li>\n          </ul>\n          <a href=\"/collections/all\">Shop Now</a>\n        </div>\n      </section>\n\n      <section class=\"hej-path-panel\">\n        <div class=\"hej-photo hej-photo-2\"><span> PAYMENT </span></div>\n        <div class=\"hej-copy\">\n          <p class=\"hej-step-num\">02</p>\n          <h3>PLACE YOUR ORDER</h3>\n          <ul>\n            <li>Safe and secure checkout.</li>\n            <li>Easy payment process.</li>\n          </ul>\n          <a href=\"/pages/contact\">shop now</a>\n        </div>\n      </section>\n\n      <section class=\"hej-path-panel\">\n        <div class=\"hej-photo hej-photo-3\"><span> PREPARED </span></div>\n        <div class=\"hej-copy\">\n          <p class=\"hej-step-num\">03</p>\n          <h3>WE PREPARE YOUR ORDER</h3>\n          <ul>\n            <li>Carefully processed.</li>\n            <li>Prepared for shipment.</li>\n          </ul>\n          <a href=\"/collections/all\">shop now</a>\n        </div>\n      </section>\n\n      <section class=\"hej-path-panel hej-path-final\">\n        <div class=\"h